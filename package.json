{
  "name": "rendra-mcp",
  "version": "0.3.0",
  "mcpName": "io.github.virusxd521/rendra",
  "description": "Model Context Protocol server for Rendra. Lets Claude, Cursor, and other MCP-compatible agents read and write docs in your Rendra workspace.",
  "type": "module",
  "author": "Daniel Benisti",
  "homepage": "https://www.rendra.design",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/virusxd521/rendra-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/virusxd521/rendra-mcp/issues"
  },
  "bin": {
    "rendra-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "test": "npm run build && node --test test/server.test.mjs test/cli.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "rendra",
    "docs",
    "ai",
    "claude"
  ],
  "license": "MIT"
}
